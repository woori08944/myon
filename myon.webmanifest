{
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "name": "마이온",
  "short_name": "마이온",
  "lang": "ko",
  "display": "standalone",
  "background_color": "#F6F3EA",
  "theme_color": "#123C30",
  "icons": [
    {
      "src": "/myon-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "data:image/png;base64,",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "any"
    },
    {
      "src": "data:image/png;base64,",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/myon-share-recording",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "recording",
          "accept": [
            "audio/mp4",
            "audio/x-m4a",
            "audio/mpeg",
            "audio/wav",
            "audio/x-wav",
            "audio/ogg",
            ".m4a",
            ".mp3",
            ".wav",
            ".ogg"
          ]
        }
      ]
    }
  }
}
